<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 启动画面使用：深色背景（与 Compose 深色主题背景 XixiColorsDark.background = #0B0B0D 一致） -->
    <color name="splash_background">#0B0B0D</color>

    <!--
        窗口背景：必须与 Compose 主题背景（XixiColorsLight.background）保持一致。
        页面切换时窗口背景会短暂露出，若这里是深色就会形成「黑色遮罩一闪而过」。
    -->
    <color name="window_background">#F5F5F7</color>
    <!-- 统一强调色（深色档 AccentDark），与应用内强调色一致 -->
    <color name="xixi_accent">#4FD1B0</color>
    <!-- 自适应图标背景：与 Compose 深色主题背景一致 -->
    <color name="ic_launcher_background">#0B0B0D</color>
</resources>
