<?xml version="1.0" encoding="utf-8"?>
<!-- 关闭系统备份与设备迁移（本地待办数据不离开设备） -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="root"
            path="." />
        <exclude
            domain="file"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="root"
            path="." />
        <exclude
            domain="file"
            path="." />
    </device-transfer>
</data-extraction-rules>
